{
  "name": "alx-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile preview --local --clear-cache",
    "build-ios": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production-test --local --clear-cache",
    "build-play": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production --local --clear-cache"
},
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.2.12",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.25",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "^17.0.8",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "^6.0.18",
    "expo-device": "^8.0.9",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.9",
    "expo-location": "^19.0.7",
    "expo-network": "^8.0.7",
    "expo-router": "~6.0.15",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-network-info": "^5.2.2",
    "react-native-pager-view": "^6.9.1",
    "react-native-permissions": "^5.4.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-tab-view": "^4.2.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "~0.21.0",
    "react-native-wifi-connector": "file:./modules/react-native-wifi-connector",
    "react-native-wifi-reborn": "^4.13.6",
    "react-native-worklets": "0.5.1",
    "victory-native": "^41.20.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.1.0",
    "eas-cli": "^21.4.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "^10.0.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-network-info"
